{
  "name": "agent-study",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "npm run build:static",
    "main": "node src/main.ts",
    "dev": "node src/main.ts",
    "cli": "node src/main.ts --cli",
    "check": "node scripts/check.mjs",
    "rag:index": "node scripts/index-knowledge.mjs",
    "start": "node src/main.ts",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "format": "prettier --write src admin scripts package.json .prettierrc.json",
    "format:check": "prettier --check src admin scripts package.json .prettierrc.json"
  },
  "engines": {
    "node": "\u003e=24"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
